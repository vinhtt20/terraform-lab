<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>${title} — tflab-05</title>
  <style>
    body { font-family: -apple-system, system-ui, sans-serif; max-width: 640px; margin: 40px auto; padding: 0 16px; }
    h1 { color: #1f6feb; }
    .pill { display: inline-block; background: #ddf4ff; color: #0969da; padding: 2px 8px; border-radius: 12px; font-size: 0.85em; }
  </style>
</head>
<body>
  <h1>${title}</h1>
  <p>Served by the <span class="pill">web_service</span> Terraform module.</p>
  <p>Build id: <code>${build_id}</code></p>
</body>
</html>
